; 21 lines 10 code 8 comments 3 blanks

; An ordinary line comment.
(define text "; #| inside a string |#")
(define escaped "\"; still string")
(define marker #\")
; A quote character does not open a string on the previous line.

#| An outer block comment.
   #| A nested block comment. |#
   ; Still inside the outer block.
|#
(define fraction 1/3)
(define multiline "start
; This is string content.
#| This is also string content. |#
end")
(list text escaped fraction) ; trailing comment

#| inline block |# (+ 1 2)
; The final comment.
